RewriteEngine On
RewriteBase /mr.millet.admin/

# -----------------------------------------
# Remove .php extension from URL
# Example: /mr.millet.admin/login.php
# becomes: /mr.millet.admin/login
# -----------------------------------------
RewriteCond %{THE_REQUEST} \s/+mr\.millet\.admin/(.+?)\.php[\s?] [NC]
RewriteCond %{REQUEST_METHOD} GET
RewriteRule ^(.+)\.php$ /mr.millet.admin/$1 [R=301,L]

# -----------------------------------------
# Don't rewrite existing files or folders
# -----------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# -----------------------------------------
# Automatically load .php files
# Example: /mr.millet.admin/login
# loads: login.php
# -----------------------------------------
RewriteRule ^(.+)$ $1.php [L,QSA]

# -----------------------------------------
# Default homepage
# -----------------------------------------
RewriteRule ^$ index.php [L]

# -----------------------------------------
# Don't rewrite AJAX POST requests
# -----------------------------------------
RewriteCond %{REQUEST_URI} ^/mr\.millet\.admin/ajax/
RewriteCond %{REQUEST_METHOD} POST
RewriteRule ^ - [L]